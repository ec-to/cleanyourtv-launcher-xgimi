+    /**
+     * Opens Settings through the vendor's settings <em>service</em> where the firmware has no settings activity
+     * at all, and returns whether the service took the request. XGIMI's GMUI 6 sets are one: com.android.newsettings
+     * has no android.settings.SETTINGS handler, its pages are floating SYSTEM_DIALOG windows a background
+     * SettingService shows over whatever is in front, and the page is named by its "data" extra alone - an Intent
+     * uri is ignored, a startActivity cannot reach a service, and a settings_fallback_components entry cannot
+     * either, since that names an activity. config.xml carries the service, the action it expects, and the page
+     * per entry (settings_service_page, wifi_service_page). Empty settings_service, or a firmware with a settings
+     * activity of its own: false, and the caller keeps its usual route.
+     */
+    static boolean startServicePage(Context context, String standardAction) {
+        ComponentName service = ComponentName.unflattenFromString(context.getString(R.string.settings_service));
+        if (service == null) return false;
+        PackageManager pm = context.getPackageManager();
+        ResolveInfo resolved = pm.resolveActivity(new Intent(standardAction), PackageManager.MATCH_DEFAULT_ONLY);
+        // A firmware that answers the standard action has a settings activity to open; leave that one alone.
+        if (resolved != null && !resolved.activityInfo.name.contains("CTSDummy")) return false;
+        String page = context.getString(Settings.ACTION_WIFI_SETTINGS.equals(standardAction)
+                ? R.string.wifi_service_page : R.string.settings_service_page);
+        if (page.isEmpty()) return false;
+        Intent i = new Intent(context.getString(R.string.settings_service_action)).setComponent(service)
+                .putExtra("data", page)
+                // XGIMI's own launcher sends true with every page (SettingPageManager.startServiceForSetting).
+                .putExtra("unlocked", true)
+                .putExtra("packageName", context.getPackageName());
+        try {
+            return context.startService(i) != null;
+        } catch (RuntimeException e) {
+            // SecurityException where the service is not open to this build; IllegalStateException where Android
+            // refuses a service start from the background (a key helper rather than Home). Fall back either way.
+            return false;
+        }
+    }
